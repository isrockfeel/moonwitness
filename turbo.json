{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "api:dev": {
      "dependsOn": ["^lint", "^typecheck"],
      "inputs": ["apps/api/**"],
      "env": ["PORT", "HOST", "NODE_ENV", "API_PREFIX"]
    },
    "api:build": {
      "dependsOn": ["^build"],
      "inputs": ["apps/api/**"]
    }
  }
}
