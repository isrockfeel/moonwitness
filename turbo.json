{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "api:dev": {
      "dependsOn": ["^lint", "^typecheck"],
      "inputs": ["apps/api/**"],
      "env": ["PORT", "HOST", "NODE_ENV", "API_PREFIX"]
    },
    "api:build": {
      "dependsOn": ["^build"],
      "inputs": ["apps/api/**"]
    },
    "radio:dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_API_BASE_URL", "VITE_WS_URL"]
    },
    "radio:build": {
      "dependsOn": ["^build"],
      "inputs": ["apps/radio/**"]
    },
    "radio:deploy": {
      "dependsOn": ["radio:build"],
      "cache": false
    }
  }
}
