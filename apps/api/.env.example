# Copy to apps/api/.env and set the bootstrap values before first boot.
# Never commit populated .env files or deploy with sample credentials.
NODE_ENV=development
DATABASE_URL=./moonwitness.db
SESSION_MAX_AGE_DAYS=7
MW_BOOTSTRAP_ADMIN_USERNAME=
MW_BOOTSTRAP_ADMIN_EMAIL=
MW_BOOTSTRAP_ADMIN_PASSWORD=
MW_BOOTSTRAP_ADMIN_DISPLAY_NAME=
