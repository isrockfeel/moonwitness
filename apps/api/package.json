    "@moonwitness/orm": "workspace:*",
    "@moonwitness/schema": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@moonwitness/eslint-config": "workspace:*",
    "@moonwitness/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
