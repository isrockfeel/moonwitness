{
  "name": "@moonwitness/radio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "deploy": "wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@moonwitness/ui": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-query-devtools": "^5.60.0",
    "hls.js": "^1.5.17",
    "wouter": "^3.3.5",
    "zustand": "^5.0.0",
    "react-intersection-observer": "^9.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241201.0",
    "@moonwitness/eslint-config": "workspace:*",
    "@moonwitness/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.0",
    "hono": "^4.6.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "^3.25.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  }
}