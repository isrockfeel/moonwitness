HOST=127.0.0.1
HTTP_PORT=8091
STORAGE_ROOT=./data
DATABASE_URL=sqlite:./storage.db?mode=rwc
STORAGE_ACCESS_KEY=moonwitness-storage
STORAGE_SECRET_KEY=change-me-storage-secret
# Set to true only for local development: skips SigV4 verification entirely.
STORAGE_ALLOW_ANONYMOUS=false
# Maximum accepted object size in bytes (default 512 MiB).
STORAGE_MAX_OBJECT_SIZE=536870912