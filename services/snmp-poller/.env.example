HOST=127.0.0.1
HTTP_PORT=8094
DATABASE_URL=sqlite:./snmp-poller.db?mode=rwc
# Default poll interval (seconds) for targets without an explicit interval.
SNMP_POLL_INTERVAL=60
# SNMP request timeout in milliseconds.
SNMP_TIMEOUT_MS=2000
# Max samples kept per target (oldest pruned). 0 = unlimited.
SNMP_MAX_SAMPLES=50000