HOST=127.0.0.1
HTTP_PORT=8092
SYSLOG_UDP_PORT=5140
SYSLOG_TCP_PORT=5514
# UDP 514/TCP 514 need elevated privileges on many systems; defaults use unprivileged ports.
DATABASE_URL=sqlite:./syslog.db?mode=rwc
# Max syslog messages kept in DB (oldest pruned on ingest when exceeded). 0 = unlimited.
SYSLOG_MAX_MESSAGES=100000